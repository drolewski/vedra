meta {
  name: POST chat knowledge
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/chat/knowledge
  body: json
  auth: inherit
}

headers {
  Accept-Language: pl
}

body:json {
  {
    "question": "W którym miejscu w tekli dodać nowy skrót klawiszowy?",
    "answer": "Otwórz menu Plik (File) w lewym górnym rogu ekranu.Przejdź do sekcji Ustawienia (Settings).Wybierz opcję Skróty klawiszowe (Keyboard shortcuts).Otworzy się nowe okno dialogowe, w którym możesz zarządzać wszystkimi komendami."
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
